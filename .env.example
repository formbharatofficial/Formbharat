# Copy to .env for local overrides. Do not put real credentials in this file.
# FormBharat does not use API keys or passwords in its current configuration.

# development or production. Production never enables the Flask debugger.
FORMBHARAT_ENV=development

# Deployment platforms such as Replit provide PORT.
HOST=0.0.0.0
PORT=5000

# Optional. Unset values keep the repository formbharat.db and documents/ folder.
# FORMBHARAT_DATABASE_PATH=
# FORMBHARAT_STORAGE_DIR=

# Optional session secret. If unset, each process uses a temporary random value.
# FORMBHARAT_SECRET_KEY=

# 32-byte document key as 64 hex characters or url-safe base64.
# Keep it outside the repository. A lost key cannot be recovered.
# Changing the key does not decrypt older files, and old files are not rewritten.
# FORMBHARAT_DOCUMENT_KEY=
# Set to 1 to reject new uploads when the key is missing or invalid.
# FORMBHARAT_REQUIRE_DOCUMENT_ENCRYPTION=
# Code required to claim an empty profile slot. Legacy slots cannot be claimed.
# FORMBHARAT_SLOT_CLAIM_CODE=
